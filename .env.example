# Copy to .env and fill in local values. Never commit real secrets.
# Production keys come from the secret store, never from this file.

# --- Django / API ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_PORT=8000

# --- JWT (portal + chat; same mechanism, §13) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# --- CORS / CSRF (prod: only the production frontend origin) ---
CORS_ALLOWED_ORIGIN=http://localhost:5173
CSRF_TRUSTED_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173

# --- PostgreSQL (application OLTP) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zarinpal
POSTGRES_USER=zarinpal
POSTGRES_PASSWORD=zarinpal

# --- ClickHouse (OLAP) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=zarinpal
CLICKHOUSE_USER=zarinpal
CLICKHOUSE_PASSWORD=zarinpal

# --- Redis (cache, rate limit, cost ledger, circuit breakers, chat checkpoints) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=zarinpal

# --- Temporal ---
# Auto-setup image uses its own Postgres (temporal-postgres), not POSTGRES_*.
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal
TEMPORAL_POSTGRES_DB=temporal
TEMPORAL_TASK_QUEUE_ANALYSIS=analysis-queue
TEMPORAL_TASK_QUEUE_AGENT=agent-queue
TEMPORAL_TASK_QUEUE_NOTIFICATION=notification-queue
TEMPORAL_TASK_QUEUE_CHAT=chat-queue

# --- AvalAI (LLM gateway) ---
# AvalAI provides a small per-developer trial budget for local dev.
# Real production keys come from the secret store and must never be committed.
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_CHEAP_MODEL=
AVALAI_MID_MODEL=
AVALAI_PREMIUM_MODEL=

# --- LLM cost ceilings (USD, CostLedger scopes: agent vs chat) ---
LLM_AGENT_PER_RUN_CEILING_USD=0.50
LLM_AGENT_MERCHANT_DAILY_CEILING_USD=5.00
LLM_AGENT_GLOBAL_DAILY_CEILING_USD=50.00
LLM_CHAT_PER_TURN_CEILING_USD=0.05
LLM_CHAT_MERCHANT_DAILY_CEILING_USD=2.00
LLM_CHAT_GLOBAL_DAILY_CEILING_USD=50.00

# --- MCP & workers (mTLS / signed keys, Sprint 4) ---
MCP_API_KEY=
MCP_MTLS_CA_PATH=
MCP_MTLS_CERT_PATH=
MCP_MTLS_KEY_PATH=
WORKER_MTLS_CA_PATH=
WORKER_MTLS_CERT_PATH=
WORKER_MTLS_KEY_PATH=

# --- Notification delivery (in-app + email MVP; SMS out of scope) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=zarinpal-dashboard
PROMETHEUS_PORT=9090
